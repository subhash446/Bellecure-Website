# =====================================================================
# Bellecure Agro Food & Co. — Environment Configuration Template
# Copy this file to .env and configure with your service credentials.
# NEVER commit .env or secrets to source control.
# =====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Allowed Origins / Domain Configuration
FRONTEND_URL=https://bellecure.co.in
CLIENT_URL=https://www.bellecure.co.in

# Database Configuration (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/bellecure?retryWrites=true&w=majority
MONGODB_URI=

# Resend Email Service Configuration
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Bellecure <inquiries@bellecure.co.in>
EMAIL_TO=sales@bellecure.co.in

# Google Gemini AI Assistant Configuration
# Recommended model: gemini-3.6-flash
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Admin Dashboard Authentication Credentials
ADMIN_EMAIL=admin@bellecure.in
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
